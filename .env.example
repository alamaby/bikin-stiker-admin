# Supabase – same project as bikinstiker (https://supabase.com/dashboard)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Prefer new publishable key; legacy anon still works as fallback
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder_eyJhbGciOiJIUzI1NiJ9_placeholder_20chars
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiJ9_placeholder_legacy_jwt_placeholder
# Server-only – never expose to client (service_role / sb_secret)
SUPABASE_SECRET_KEY=sb_secret_placeholder_eyJhbGciOiJIUzI1NiJ9_placeholder_20chars
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiJ9_placeholder_service_role_placeholder

# Admin whitelist – comma separated, lowercased at runtime
# Server-only – never expose to client bundle
ADMIN_EMAILS=alam.aby.b@gmail.com,alamaby@gmail.com,alamaby+bikinstiker@gmail.com
# Deprecated: NEXT_PUBLIC_ADMIN_EMAILS is no longer needed (avoids leaking emails in client JS)

# Public app URL (for redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder_eyJhbGciOiJIUzI1NiJ9_placeholder_20chars
